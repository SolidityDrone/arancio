# Copy to .env and fill in locally. Never commit .env.

# Ethereum signing key for CRE (hex) or secret manager reference
CRE_ETH_PRIVATE_KEY=

# Solana key: path to keypair JSON, or use CRE tooling defaults
CRE_SOLANA_PRIVATE_KEY=

