# Copy to .env.local for local Next.js / API routes. Never commit secrets.

# Solana RPC (browser + server)
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8899
ARANCIO_RPC_URL=http://127.0.0.1:8899

# Pool launch authority — file path or JSON byte array (server only, not NEXT_PUBLIC)
# SOLANA_KEYPAIR_PATH=~/.config/solana/id.json
# SOLANA_KEYPAIR_JSON=

# Optional: external launch backend URL for /app
# NEXT_PUBLIC_LAUNCH_API_URL=

# yield backend: kamino | yield_cusdc (local test mint)
# NEXT_PUBLIC_ARANCIO_YIELD_BACKEND=kamino
